{
  "name": "frontend",
  "version": "1.0.0",
  "packageManager": "pnpm@10.20.0",
  "description": "OhMyStock read-only web dashboard",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
